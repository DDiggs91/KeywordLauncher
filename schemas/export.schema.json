{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keyword Launcher export file",
  "type": "object",
  "required": ["version", "shortcuts"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "settings": {
      "type": "object",
      "properties": {
        "unknownKeyword": { "enum": ["search", "nothing"] },
        "defaultTarget": { "enum": ["currentTab", "newForegroundTab", "newBackgroundTab"] }
      }
    },
    "shortcuts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "keyword", "steps"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "keyword": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,32}$" },
          "description": { "type": "string", "maxLength": 120 },
          "requiresQuery": { "type": "boolean" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "urls": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": { "type": "string" }
                },
                "disabled": { "type": "boolean" },
                "continueOnError": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
