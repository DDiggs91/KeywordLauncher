{
  "manifest_version": 3,
  "name": "Keyword Launcher",
  "version": "1.0.0",
  "description": "Type \"go work\" in the address bar to run saved steps: open pages, group tabs, and more.",
  "minimum_chrome_version": "120",
  "omnibox": { "keyword": "go" },
  "permissions": ["tabs", "tabGroups", "storage", "offscreen"],
  "optional_permissions": ["userScripts"],
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "action": { "default_title": "Keyword Launcher" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
